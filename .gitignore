# Dependencies
node_modules/
.venv/

# Build outputs
dist/
build/
release/

# Rust build
src-tauri/target/
# Tauri regenerates this host-specific schema during macOS checks; the shared
# desktop schema is the tracked editor contract.
src-tauri/gen/schemas/macOS-schema.json

# Compiled Python binaries (sidecar)
src-tauri/bin/

# Python cache
__pycache__/
*.pyc
*.pyo
python/__pycache__/

# OS files
.DS_Store
Thumbs.db
desktop.ini
.macos-bootstrap-state

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment files (may contain keys)
.env
.env.*
!.env.example

# Logs
*.log

# Local Product Atelier runtime data (may include private API settings)
config.json
*.sqlite3
*.sqlite3-*
*.db
*.db-*
.config.json.*.tmp
config.json.lock
output/
history/
assets/
/models/
/model-cache/

# Local backups and scratch artifacts
backup/
backups/
*.bak*
*.oldbackup
*.testbak
*.v*bak
*.v*backup
*.broken*
/_*
/fix*.py
/fix*.cjs
/patch*.py
/write*.py
/write*.cjs
/test-*.png

# Retired UI experiment layers not referenced by the current entry point
/src/body-structure.html
/src/css/tailwind.css
/src/css/ui-clean.css
/src/css/v*.css
/src/js/_appjs_parts/
/src/js/shoelace-setup.js
/src/js/ui-clean.js
/src/js/v*.js
/src/js/vfinal-ui.js
/src/public/
/src/v*.css
/src/v*.js
