{
  "schema_version": "1.0",
  "corpus_id": "product-atelier-semantic-grounding-contract-v1",
  "corpus_kind": "procedural-contract",
  "review": "source-controlled",
  "description": "不含用户图片的离线几何与失败恢复合同；用于验证适配器、指标和界面回退，不代表真实电商照片质量。",
  "limitations": [
    "程序绘制图只验证合同与评测器，不能替代真实照片模型质量结论",
    "真实质量语料必须另行记录来源、许可、SHA-256 和人工标注审核"
  ],
  "required_coverage": [
    "food",
    "multiple-similar",
    "packaging",
    "transparent",
    "hair-fine-lines",
    "shadow",
    "occlusion",
    "no-match"
  ],
  "gates": {
    "iou_threshold": 0.5,
    "min_recall": 0.75,
    "min_precision": 0.75,
    "min_exact_count_accuracy": 0.75,
    "min_no_match_accuracy": 1.0,
    "min_recovery_rate": 1.0
  },
