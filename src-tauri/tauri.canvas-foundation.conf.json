{
  "productName": "Product Atelier Canvas Foundation Prototype",
  "identifier": "com.productatelier.canvas-foundation-prototype",
  "build": {
    "beforeBuildCommand": "npm --prefix prototypes/canvas-replacement-v1 run build",
    "frontendDist": "../prototypes/canvas-replacement-v1/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Product Atelier Canvas Foundation Prototype",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "shadow": true,
        "dragDropEnabled": false,
        "backgroundColor": "#ECEBE7"
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
